  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Question"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "AskResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "title": "Sources"
          },
          "is_mock": {
            "type": "boolean",
            "title": "Is Mock"
          },
          "insufficient_evidence": {
            "type": "boolean",
            "title": "Insufficient Evidence"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "sources",
          "is_mock",
          "insufficient_evidence"
        ],
        "title": "AskResponse"
      },
      "Body_upload_documents_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_documents_post"
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message"
          },
          "persona": {
            "type": "string",
            "enum": [
              "cautious",
              "aggressive",
              "fee_sensitive",
              "short_term"
            ],
            "title": "Persona",
            "default": "cautious"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "maxItems": 24,
            "title": "History"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "ComplianceFlag": {
        "properties": {
          "turn": {
            "type": "integer",
            "title": "Turn"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "quote": {
            "type": "string",
            "title": "Quote"
          },
          "trigger": {
            "type": "string",
            "title": "Trigger"
          },
          "status": {
            "type": "string",
            "const": "needs_review",
            "title": "Status"
          },
          "method": {
            "type": "string",
            "const": "local_rules",
            "title": "Method"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Source Ids"
          },
          "evidence_status": {
            "type": "string",
            "enum": [
              "retrieved_context",
              "missing"
            ],
            "title": "Evidence Status"
          }
        },
        "type": "object",
        "required": [
          "turn",
          "category",
          "quote",
          "trigger",
          "status",
          "method",
          "reason",
          "source_ids",
          "evidence_status"
        ],
        "title": "ComplianceFlag"
      },
      "DimensionScore": {
        "properties": {
          "dimension": {
            "type": "string",
            "enum": [
              "專業準確度",
              "需求探索",
              "同理心",
              "異議處理",
              "風險揭露"
            ],
            "title": "Dimension"
          },
          "score": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "evidence_quote": {
            "type": "string",
            "title": "Evidence Quote"
          },
          "citation_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Citation Ids"
          }
        },
        "type": "object",
        "required": [
          "dimension",
          "score",
          "reason",
          "evidence_quote",
          "citation_ids"
        ],
        "title": "DimensionScore"
      },
      "DocumentInfo": {
        "properties": {
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "chunks": {
            "type": "integer",
            "title": "Chunks"
          }
        },
        "type": "object",
        "required": [
          "filename",
          "chunks"
        ],
        "title": "DocumentInfo"
      },
      "EmotionAnalysis": {
        "properties": {
          "label": {
            "type": "string",
            "enum": [
              "平穩",
              "緊張",
              "不耐煩",
              "挫折",
              "正向",
              "不明確"
            ],
            "title": "Label"
          },
          "intensity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "unknown"
            ],
            "title": "Intensity"
          },
          "evidence_quote": {
            "type": "string",
            "title": "Evidence Quote"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "suggestion": {
            "type": "string",
            "title": "Suggestion"
          },
          "is_mock": {
            "type": "boolean",
            "title": "Is Mock"
          }
        },
        "type": "object",
        "required": [
          "label",
          "intensity",
          "evidence_quote",
          "reason",
          "suggestion",
          "is_mock"
        ],
        "title": "EmotionAnalysis"
      },
      "EmotionSnapshot": {
        "properties": {
          "turn": {
            "type": "integer",
            "title": "Turn"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "completed",
              "failed"
            ],
            "title": "Status"
          },
          "analysis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EmotionAnalysis"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "turn",
          "status",
          "analysis",
          "error"
        ],
        "title": "EmotionSnapshot"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "EvaluateRequest": {
        "properties": {
          "history": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "maxItems": 24,
            "minItems": 1,
            "title": "History"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "history"
        ],
        "title": "EvaluateRequest"
      },
      "EvaluateResponse": {
        "properties": {
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "scores": {
            "items": {
              "$ref": "#/components/schemas/DimensionScore"
            },
            "type": "array",
            "title": "Scores"
          },
          "improvements": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Improvements"
