{
  "name": "ai-coach",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "predev": "bash scripts/dev/ensure-services.sh",
    "dev": "pnpm --filter @ai-coach/web dev",
    "stt:install": "bash scripts/dev/install-mac-stt-service.sh",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "api:dev": "cd apps/api && .venv/bin/uvicorn app.main:app --reload --port 8000",
    "bootstrap": "bash scripts/bootstrap.sh",
    "check:services": "bash scripts/bootstrap.sh --check-services",
    "avatar:dev": "cd services/avatar-runtime && .venv/bin/uvicorn app.main:app --reload --host 127.0.0.1 --port 8765",
    "inference:dev": "cd services/inference && .venv/bin/uvicorn app.main:app --reload --host 127.0.0.1 --port 8770",
    "avatar:verify": "cd services/avatar-runtime && .venv/bin/python scripts/verify_install.py",
    "avatar:bench": "cd services/avatar-runtime && .venv/bin/python scripts/benchmark.py",
    "check:contracts": "bash scripts/check-contracts.sh"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
