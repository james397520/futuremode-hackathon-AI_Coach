# ---- Web (apps/web) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
NEXT_PUBLIC_ENABLE_WEBGPU=auto        # auto | on | off

# ---- API (apps/api) ----
APP_ENV=local
# Native local PostgreSQL: use your system account or set an explicit database role.
DATABASE_URL=postgresql+asyncpg://localhost:5432/aicoach
REDIS_URL=redis://localhost:6379/0
# The default needs no Qdrant or MinIO. Use qdrant/S3 or compatible managed services
# for persistent knowledge-base retrieval and uploaded files.
VECTOR_BACKEND=memory
QDRANT_URL=http://localhost:6333
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-coach
OBJECT_STORAGE_ENABLED=false

# Secrets NEVER reach the browser (spec §56 / §70 / §71)
# Choose exactly one primary LLM provider. MiniMax is used by every conversation agent.
LLM_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic/v1
MINIMAX_MODEL=MiniMax-M2.7-highspeed
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
TTS_PROVIDER=none
JWT_SECRET=change-me

# ---- Avatar Runtime (services/avatar-runtime) ----
# Local Digital Human. Binds to loopback only; nginx proxies /avatar/ in production.
# Backend is auto-detected (Apple Silicon MLX / NVIDIA CUDA-TensorRT / static portrait).
AVATAR_BACKEND=auto                   # auto | mac_mlx | rtx_cuda | static
AVATAR_HOST=127.0.0.1
AVATAR_PORT=8765
AVATAR_DEFAULT_FPS=25
AVATAR_DEFAULT_WIDTH=512
AVATAR_DEFAULT_HEIGHT=512
AVATAR_MODE=state_bank                # state_bank | continuous
AVATAR_WEBRTC=false                   # Phase 1 ships WebSocket frames; WebRTC is Phase 2

# Engine selection is only consulted when the corresponding runtime is installed.
# With neither installed the service still serves the static-portrait fallback, and a
# training session must never fail because the avatar did (avatar spec §53).
# Apple Silicon:
#   LIVEPORTRAIT_ENGINE=fasterliveportrait_mlx
#   MUSETALK_ENGINE=musetalk_mlx
#   MUSETALK_PRECISION=fp16           # fp16 | q8 | q4
# NVIDIA RTX:
#   LIVEPORTRAIT_ENGINE=fasterliveportrait_trt
#   MUSETALK_ENGINE=official_v15

# ---- Inference Service (services/inference) ----
# Private embedding / rerank runtime. Loopback only, never publicly exposed.
INFERENCE_HOST=127.0.0.1
INFERENCE_PORT=8770
INFERENCE_ENABLED=false               # true once local model weights are provisioned

# ---- Web -> local runtimes ----
# Same-machine development talks to loopback directly. Behind nginx these become
# same-origin paths (/avatar) so no extra CSP connect-src entry is needed in production.
NEXT_PUBLIC_AVATAR_BASE_URL=http://127.0.0.1:8765
NEXT_PUBLIC_AVATAR_WS_URL=ws://127.0.0.1:8765
