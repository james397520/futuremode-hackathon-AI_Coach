[Unit]
Description=AI Coach FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=ai-coach
Group=ai-coach
WorkingDirectory=/opt/ai-coach/apps/api
EnvironmentFile=/etc/ai-coach/ai-coach.env
ExecStart=/opt/ai-coach/apps/api/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
